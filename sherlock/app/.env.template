# Your installation. Browser-visible values are not server secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Private WorkOS configuration. Generate independent secrets for your installation.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=

# Private deployment and application/backend signing configuration.
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
WEBHOOK_SECRET=
STORAGE_SECRET=
VDR_GUEST_SERVER_SECRET=
VDR_GUEST_SERVER_AUDIENCE=
ADMIN_VDR_CAPABILITY_SECRET=
INTAKE_SERVER_SECRET=
INTAKE_SERVER_AUDIENCE=

# Configure these in your Convex deployment where required.
# APP_URL, WORKOS_CLIENT_ID, RESEND_API_KEY, RESEND_FROM_EMAIL,
# WEBHOOK_SECRET, STORAGE_SECRET, VDR_GUEST_SERVER_SECRET,
# VDR_GUEST_SERVER_AUDIENCE, ADMIN_VDR_CAPABILITY_SECRET,
# INTAKE_SERVER_SECRET, INTAKE_SERVER_AUDIENCE

# Optional MCP access. Use your installation's issuer and addresses.
VDR_MCP_ENABLED=false
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_TENANT_CLAIM=
MCP_OAUTH_CLIENT_ID_CLAIM=
VDR_MCP_SERVER_SECRET=
VDR_MCP_SERVER_AUDIENCE=
VDR_MCP_OAUTH_AUDIENCE=
VDR_MCP_OAUTH_SCOPE_BASE=

# Optional analytics: your own project only. Leave unset to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ENABLE_POSTHOG_IN_DEV=false

# Production requires shared rate limiting by default.
# For a single-process installation only, explicitly choose RATE_LIMIT_PROVIDER=memory.
# Never use memory for a multi-instance deployment.
RATE_LIMIT_PROVIDER=upstash
# Shared rate-limiter settings:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production must never enable development bypasses.
BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false

# Set these separately in the Convex deployment, not only the Next.js app:
# CONVEX_ENV=production
# APP_URL=https://your-installation.example.com
# GUEST_IDENTITY_HASH_SECRET=<generate an independent random secret>
# GUEST_OTP_PEPPER=<generate an independent random secret>
# RESEND_API_KEY=<your own key>
# RESEND_FROM_EMAIL=<your verified sender>
# RESEND_TEST_MODE=false
