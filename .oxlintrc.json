    "reports/**",
    "pivot-Sherlock/**",
    "llm-wiki/bundle/**"
  ],

  "overrides": [
    {
      // Tests, e2e, scripts y config: la consola es la salida, el `any` de un
      // mock no es el `any` de produccion, y un doble de IndexedDB o de
      // FileReader imita al navegador tal cual — incluido su error nulo.
      "files": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/e2e/**",
        "**/scripts/**",
        "**/*.config.ts",
        "**/*.config.mjs",
        "llm-wiki/**"
      ],
      "rules": {
        "eslint/no-console": "off",
        "typescript/no-explicit-any": "off",
        // Los .mjs de operador y los dobles de test no tienen cobertura de
        // tipos: la familia no-unsafe-* ahi es ruido, no deuda.
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-implied-eval": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "oxc/no-barrel-file": "off",
        "unicorn/no-process-exit": "off"
      }
    },
    {
      // `node:test` es dueño de la promesa que devuelve cada `test(...)` de nivel
      // superior: el runner la espera. Marcar 25 llamadas con `void` seria ruido,
      // y cada test nuevo tendria que repetirlo.
      "files": ["**/*.test.mjs"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
